# ────────── Haunt environment ──────────
# Copy to .env.local for local dev. Set the same values in Vercel for prod.

# ── Auth (NextAuth v5 / Auth.js) ─────────────────────────────────────────

# Random 32-byte secret. Generate with: openssl rand -base64 32
# (Legacy NEXTAUTH_SECRET is also accepted.)
AUTH_SECRET=

# Optional. Set automatically by Vercel in prod. Local dev uses http://localhost:3000.
# (Legacy NEXTAUTH_URL is also accepted.)
AUTH_URL=http://localhost:3000

# Set trust to 1 when running behind Vercel's proxy (it is, by default)
AUTH_TRUST_HOST=1

# GitHub OAuth app — create at https://github.com/settings/developers
# Authorization callback URL must include both:
#   https://haunt-pied.vercel.app/api/auth/callback/github
#   http://localhost:3000/api/auth/callback/github
# Either naming convention works (AUTH_GITHUB_* or GITHUB_*):
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ── Database (Vercel Postgres / Neon) ────────────────────────────────────
# These are auto-injected when you connect a Vercel Postgres / Neon integration.
# For local dev, paste the same pooled URL.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# ── Blob storage (Vercel Blob) ───────────────────────────────────────────
# Auto-set by the Vercel Blob integration. For local dev, generate a token
# from the Vercel dashboard → Storage → Blob → "Create token".
BLOB_READ_WRITE_TOKEN=
